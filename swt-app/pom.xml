<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.example</groupId>
        <artifactId>warehouse-demo-swt</artifactId>
        <version>1.0-SNAPSHOT</version>
    </parent>
    <artifactId>warehouse-swt-app</artifactId>
    <version>3.5.0</version>
    <name>WarehousePro 3.5 (SWT)</name>
    <description>The WarehousePro desktop application, reimplemented in plain SWT.</description>

    <properties>
        <main.class>com.example.warehouse.swt.WarehouseApp</main.class>
    </properties>

    <dependencies>
        <dependency>
            <groupId>com.example</groupId>
            <artifactId>warehouse-core</artifactId>
            <version>3.5.0</version>
        </dependency>
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-simple</artifactId>
            <version>2.0.9</version>
        </dependency>
        <!-- @ExposedMethod / @InstanceProvider on BridgeApp, read at build time by
             the Vaadin app's codegen; not needed at runtime. -->
        <dependency>
            <groupId>com.vaadin</groupId>
            <artifactId>swing-bridge-annotations</artifactId>
            <version>${swing-bridge.version}</version>
            <scope>provided</scope>
        </dependency>
        <!-- SWT comes from the host at runtime (desktop launcher or bridge); never shaded. -->
        <dependency>
            <groupId>org.eclipse.platform</groupId>
            <artifactId>org.eclipse.swt.${swt.platform}</artifactId>
            <version>${swt.version}</version>
            <scope>provided</scope>
            <exclusions>
                <!-- The fragment's POM points back at the host bundle, whose POM
                     resolves the fragment via ${osgi.platform}; the fragment is self-contained. -->
                <exclusion>
                    <groupId>*</groupId>
                    <artifactId>*</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- One self-contained jar (without SWT), for the desktop and for a bridge's applibs. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.5.2</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals><goal>shade</goal></goals>
                        <configuration>
                            <createDependencyReducedPom>false</createDependencyReducedPom>
                            <artifactSet>
                                <excludes>
                                    <exclude>org.eclipse.platform:*</exclude>
                                </excludes>
                            </artifactSet>
                            <filters>
                                <filter>
                                    <artifact>*:*</artifact>
                                    <excludes>
                                        <exclude>META-INF/*.SF</exclude>
                                        <exclude>META-INF/*.DSA</exclude>
                                        <exclude>META-INF/*.RSA</exclude>
                                        <exclude>module-info.class</exclude>
                                        <exclude>META-INF/versions/*/module-info.class</exclude>
                                    </excludes>
                                </filter>
                            </filters>
                            <transformers>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                                    <mainClass>${main.class}</mainClass>
                                </transformer>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
                            </transformers>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <!--
              mvn -pl swt-app exec:exec   runs the desktop app (after mvn install).
              The test-scope class path includes the provided SWT jar; on macOS the
              mac profiles set swt.firstThreadArg to -XstartOnFirstThread.
            -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.5.0</version>
                <configuration>
                    <executable>java</executable>
                    <!-- test scope = compile + provided (SWT) + runtime (Hibernate internals); no test deps exist -->
                    <classpathScope>test</classpathScope>
                    <workingDirectory>${project.basedir}</workingDirectory>
                    <arguments>
                        <argument>--enable-native-access=ALL-UNNAMED</argument>
                        <argument>${swt.firstThreadArg}</argument>
                        <argument>-classpath</argument>
                        <classpath/>
                        <argument>${main.class}</argument>
                    </arguments>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
